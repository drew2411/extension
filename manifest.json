{
  "manifest_version": 3,
  "name": "Custom Content Blocker: Improve Productivity",
  "version": "4.0",
  "description": "Block custom content on Reddit, YouTube & IG using AI. Features website, homepage, content group timers and creator blocks. Requires a user-provided Groq API Key.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Selective Content Blocker"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/r/*"],
      "js": ["reddit.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["youtube.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["options.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "logo_16.png",
    "32": "logo_32.png",
    "48": "logo_48.png",
    "128": "logo_128.png"
  }
}